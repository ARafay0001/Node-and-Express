<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Express Home</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen flex flex-col items-center py-10">

  <!-- Header -->
  <h1 class="text-4xl font-bold text-blue-600 mb-6">
    WELCOME TO EXPRESS
  </h1>

  <!-- Add Home Button -->
  <a 
    href="/host/add-home"
    class="bg-red-500 hover:bg-red-600 text-white font-semibold px-5 py-2 rounded-lg shadow-md transition"
  >
    ADD HOME
  </a>

  <!-- Spacing -->
  <div class="mt-10 w-full max-w-md">

    <h2 class="text-xl font-semibold text-gray-700 mb-4 text-center">
      Registered Homes
    </h2>

    <!-- List -->
    <ul class="space-y-3">

      <% registeredhouseName.forEach(home => { %>

        <li class="bg-white p-4 rounded-lg shadow hover:shadow-lg transition text-gray-800 text-center">
          <%= home.houseName %>
        </li>

      <% }) %>

    </ul>

  </div>

</body>
</html>