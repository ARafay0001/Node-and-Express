<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/output.css">
  <title>404 - Page Not Found</title>
</head>

<body class="bg-slate-100 min-h-screen">

  <%- include('partials/header') %>

  <main class="flex flex-col items-center justify-center text-center py-24 px-6">

    <h1 class="text-8xl font-extrabold text-red-500 drop-shadow-md">
      404
    </h1>

    <h2 class="mt-4 text-3xl font-bold text-slate-800">
      Page Not Found
    </h2>

    <p class="mt-3 text-slate-600 max-w-md">
      The page you're looking for doesn't exist or may have been moved.
    </p>

    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-blue-600 px-6 py-3 text-white font-semibold shadow-lg transition hover:bg-blue-700 hover:scale-105"
    >
      Go Back Home
    </a>

  </main>

</body>
</html>